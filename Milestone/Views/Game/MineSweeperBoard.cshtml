@model Milestone.Models.BoardViewModel
@{
    ViewData["Title"] = "Minesweeper";
}

<style>
    .board {
        display: inline-flex;
        flex-direction: column;
        gap: 0;
    }
    .board-row {
        display: flex;
        flex-direction: row;
        gap: 0;
    }
    .cell-btn {
        width: 60px;
        height: 60px;
        padding: 0;
        border: 1px solid #999;
        background: none;
        cursor: pointer;
    }
    .cell-btn img {
        width: 60px;
        height: 60px;
        display: block;
    }
</style>

<div class="d-flex flex-column align-items-center mt-4">
    <h4 class="mb-3">Minesweeper</h4>

    <div class="d-flex gap-2 mb-3">
        <a asp-controller="Game" asp-action="NewGame" class="btn btn-secondary">New Game</a>
        <form asp-controller="Game" asp-action="SaveGame" method="post">
            <button type="submit" class="btn btn-primary">Save Game</button>
        </form>
        <a asp-controller="Game" asp-action="SavedGames" class="btn btn-outline-primary">Show Saved Games</a>
        <a asp-controller="Game" asp-action="Exit" class="btn btn-danger">Exit</a>
    </div>

    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success py-1 px-3">@TempData["Message"]</div>
    }

    <p class="text-muted small mb-2">Last AJAX update: <span id="ajax-timestamp">none yet</span></p>

    <div class="board">
        @foreach (var row in Model.Grid)
        {
            <div class="board-row">
                @foreach (var cell in row)
                {
                    @await Html.PartialAsync("_CellPartial", cell)
                }
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(function () {
            var $board = $('.board');

            // Swap each changed cell's button for the partial HTML
            function updateCells(cells) {
                cells.forEach(function (cell) {
                    $('#cell-' + cell.row + '-' + cell.col).replaceWith(cell.html);
                });
            }

            function updateTimestamp(timestamp) {
                $('#ajax-timestamp').text(timestamp);
            }

            // Left click: reveal the cell via AJAX instead of posting/reloading the whole page.
            $board.on('click', '.cell-btn', function () {
                var $btn = $(this);

                // flagged cells ignore left-click
                if ($btn.data('flagged') === true) return;

                $.post('@Url.Action("RevealCell")', {
                    row: $btn.data('row'),
                    col: $btn.data('col')
                }, function (data) {
                    updateCells(data.cells);
                    updateTimestamp(data.timestamp);

                    // Game logic win/loss is decided server-side
                    if (data.status === 'Won') window.location.href = '@Url.Action("GameWon")';
                    else if (data.status === 'Lost') window.location.href = '@Url.Action("GameLost")';
                });
            });

            // Right click: toggle a flag via AJAX instead of revealing the cell.
            $board.on('contextmenu', '.cell-btn', function (e) {
                e.preventDefault(); // suppress the browser context menu

                var $btn = $(this);

                // can't flag an already-revealed cell
                if ($btn.data('revealed') === true) return false; 

                $.post('@Url.Action("ToggleFlag")', {
                    row: $btn.data('row'),
                    col: $btn.data('col')
                }, function (data) {
                    updateCells(data.cells);
                    updateTimestamp(data.timestamp);
                });

                return false;
            });
        });
    </script>
}
